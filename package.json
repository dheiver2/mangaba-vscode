{
  "name": "mangaba-ai",
  "displayName": "Mangaba AI",
  "description": "The sovereign Brazilian AI copilot: chat, autonomous agent, code editing, attachments (PDF/image) and RAG — works out of the box or 100% on your own infrastructure (OpenAI-compatible).",
  "version": "0.12.0",
  "publisher": "mangaba-ai",
  "icon": "media/icon-128.png",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/dheiver2/mangaba-vscode.git"
  },
  "bugs": {
    "url": "https://github.com/dheiver2/mangaba-vscode/issues"
  },
  "homepage": "https://mangaba.ia.br",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "AI",
    "Chat",
    "Machine Learning"
  ],
  "keywords": [
    "mangaba",
    "ai",
    "chat",
    "brasil",
    "llm",
    "copilot",
    "soberana",
    "copilot alternative",
    "cursor alternative",
    "codeium alternative",
    "autonomous agent",
    "self-hosted",
    "on-premise",
    "rag",
    "mcp",
    "open source ai",
    "openai-compatible",
    "code assistant",
    "pair programming"
  ],
  "galleryBanner": {
    "color": "#1E0D01",
    "theme": "dark"
  },
  "activationEvents": [],
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "mangaba",
          "title": "Mangaba AI",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "mangaba": [
        {
          "type": "webview",
          "id": "mangaba.chatView",
          "name": "Chat"
        }
      ]
    },
    "commands": [
      {
        "command": "mangaba.openChat",
        "title": "Open Chat",
        "category": "Mangaba AI"
      },
      {
        "command": "mangaba.newChat",
        "title": "New Conversation",
        "category": "Mangaba AI",
        "icon": "$(add)"
      },
      {
        "command": "mangaba.exportChat",
        "title": "Export Conversation (Markdown)",
        "category": "Mangaba AI",
        "icon": "$(export)"
      },
      {
        "command": "mangaba.setApiKey",
        "title": "Set API Key (secure)",
        "category": "Mangaba AI",
        "icon": "$(key)"
      },
      {
        "command": "mangaba.explainSelection",
        "title": "Explain Selection",
        "category": "Mangaba AI",
        "icon": "$(sparkle)"
      },
      {
        "command": "mangaba.editSelection",
        "title": "Edit Selection (AI)",
        "category": "Mangaba AI",
        "icon": "$(wand)"
      },
      {
        "command": "mangaba.agentTask",
        "title": "Project Task (agent)",
        "category": "Mangaba AI",
        "icon": "$(rocket)"
      },
      {
        "command": "mangaba.generateTests",
        "title": "Generate Tests",
        "category": "Mangaba AI",
        "icon": "$(beaker)"
      },
      {
        "command": "mangaba.fixDiagnostics",
        "title": "Fix Errors with AI",
        "category": "Mangaba AI",
        "icon": "$(lightbulb-autofix)"
      },
      {
        "command": "mangaba.commitMessage",
        "title": "Generate Commit Message",
        "category": "Mangaba AI",
        "icon": "$(sparkle)"
      },
      {
        "command": "mangaba.pickContext",
        "title": "Add Context (@)",
        "category": "Mangaba AI",
        "icon": "$(mention)"
      },
      {
        "command": "mangaba.openHistory",
        "title": "Saved Conversations",
        "category": "Mangaba AI",
        "icon": "$(history)"
      },
      {
        "command": "mangaba.indexProject",
        "title": "Index Project (RAG @codebase)",
        "category": "Mangaba AI",
        "icon": "$(database)"
      },
      {
        "command": "mangaba.agentLoop",
        "title": "Autonomous Agent (task)",
        "category": "Mangaba AI",
        "icon": "$(run-all)"
      },
      {
        "command": "mangaba.undoAgent",
        "title": "Undo Agent Session",
        "category": "Mangaba AI",
        "icon": "$(discard)"
      }
    ],
    "keybindings": [
      {
        "command": "mangaba.openChat",
        "key": "ctrl+alt+m",
        "mac": "cmd+alt+m"
      },
      {
        "command": "mangaba.explainSelection",
        "key": "ctrl+alt+e",
        "mac": "cmd+alt+e",
        "when": "editorHasSelection"
      },
      {
        "command": "mangaba.editSelection",
        "key": "ctrl+alt+k",
        "mac": "cmd+alt+k",
        "when": "editorHasSelection"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "mangaba.newChat",
          "when": "view == mangaba.chatView",
          "group": "navigation"
        }
      ],
      "editor/context": [
        {
          "command": "mangaba.editSelection",
          "when": "editorHasSelection",
          "group": "1_mangaba@1"
        },
        {
          "command": "mangaba.explainSelection",
          "when": "editorHasSelection",
          "group": "1_mangaba@2"
        },
        {
          "command": "mangaba.generateTests",
          "group": "1_mangaba@3"
        }
      ],
      "scm/title": [
        {
          "command": "mangaba.commitMessage",
          "when": "scmProvider == git",
          "group": "navigation"
        }
      ],
      "commandPalette": [
        {
          "command": "mangaba.newChat",
          "when": "false"
        }
      ]
    },
    "configuration": {
      "title": "Mangaba AI",
      "properties": {
        "mangaba.baseUrl": {
          "type": "string",
          "default": "https://router.mangaba.ia.br/v1",
          "markdownDescription": "**OpenAI-compatible** endpoint of the Mangaba Router (root ending in `/v1`). It already points to the router; replace it with **your own** if you prefer.",
          "order": 1
        },
        "mangaba.model": {
          "type": "string",
          "default": "mangaba-titan",
          "enum": [
            "mangaba-auto",
            "mangaba-titan",
            "mangaba-coder",
            "mangaba-agente",
            "mangaba-agente-rapido",
            "mangaba-agente-hibrido",
            "mangaba-bolt",
            "mangaba-vl"
          ],
          "enumDescriptions": [
            "Router — picks the model per request",
            "Most capable: agents, code and vision (GPU)",
            "Code and agent specialist",
            "General-purpose agent with tools",
            "Fast agent for customer support",
            "Long-context agent",
            "Light, precise reasoning",
            "Multimodal (text + image)"
          ],
          "markdownDescription": "Initial model. The **selector at the top of the chat** lists the server's models and overrides this option.",
          "order": 2
        },
        "mangaba.apiKey": {
          "type": "string",
          "default": "",
          "scope": "application",
          "markdownDescription": "**Deprecated** — use the command *Mangaba AI: Set API Key (secure)*, which stores the key encrypted in the system. This field exists only for migration.",
          "order": 3
        },
        "mangaba.redactSecrets": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "**Redacts secrets** (API keys, tokens, passwords, private keys) from the context and attachments before sending to the model.",
          "order": 12
        },
        "mangaba.temperature": {
          "type": "number",
          "default": 0.7,
          "minimum": 0,
          "maximum": 2,
          "markdownDescription": "Sampling temperature (0 = deterministic, 2 = creative).",
          "order": 4
        },
        "mangaba.maxTokens": {
          "type": "number",
          "default": 4096,
          "minimum": 1,
          "markdownDescription": "Maximum tokens in the response.",
          "order": 5
        },
        "mangaba.includeActiveFile": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Sends the **active file/selection** as context to the chat, so the model understands the code you are writing.",
          "order": 6
        },
        "mangaba.maxContextChars": {
          "type": "number",
          "default": 6000,
          "minimum": 500,
          "markdownDescription": "Maximum characters of the file sent as context (avoids overflowing the model's window).",
          "order": 7
        },
        "mangaba.reviewBeforeApply": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Shows a **diff (current × proposed)** and asks for confirmation before applying code in the editor. Turn off to apply directly.",
          "order": 8
        },
        "mangaba.inlineCompletions": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "**Inline autocomplete (ghost text)** as you type. *Opt-in:* Mangaba's 8K models are not low-latency, so the suggestion may be slow — better with a fast endpoint. Trigger manually with `Alt+\\`.",
          "order": 9
        },
        "mangaba.useCodebaseContext": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Uses the **local project index** (RAG @codebase) to retrieve relevant snippets and inject them into the chat. Run **Mangaba AI: Index Project** first. 100% local embeddings (transformers.js), nothing leaves the machine.",
          "order": 10
        },
        "mangaba.embeddingsBackend": {
          "type": "string",
          "enum": [
            "transformers",
            "ollama"
          ],
          "default": "transformers",
          "enumDescriptions": [
            "Local, bundled (transformers.js) — self-contained, but the vsix gets large/per-platform",
            "Local Ollama (HTTP) — light/portable vsix; requires Ollama + `ollama pull nomic-embed-text`"
          ],
          "markdownDescription": "**Embeddings** backend for RAG @codebase.",
          "order": 11
        },
        "mangaba.ollamaEmbedUrl": {
          "type": "string",
          "default": "http://localhost:11434/api/embeddings",
          "markdownDescription": "Ollama embeddings URL (when `embeddingsBackend = ollama`).",
          "order": 12
        },
        "mangaba.ollamaEmbedModel": {
          "type": "string",
          "default": "nomic-embed-text",
          "markdownDescription": "Ollama embedding model.",
          "order": 13
        },
        "mangaba.commandApproval": {
          "type": "string",
          "enum": [
            "always",
            "never"
          ],
          "default": "always",
          "scope": "application",
          "enumDescriptions": [
            "Asks for approval on every command (recommended)",
            "Runs commands without asking (careful)"
          ],
          "markdownDescription": "Approval of terminal commands from the **autonomous agent**. (User settings only — repositories cannot change it.)",
          "order": 14
        },
        "mangaba.testCommand": {
          "type": "string",
          "default": "",
          "scope": "application",
          "markdownDescription": "Test command suggested to the agent (e.g. `npm test`, `pytest`). (User settings only — repositories cannot change it.)",
          "order": 15
        },
        "mangaba.agentMaxSteps": {
          "type": "number",
          "default": 12,
          "minimum": 1,
          "maximum": 40,
          "markdownDescription": "Maximum steps of the agent loop.",
          "order": 16
        },
        "mangaba.mcpServers": {
          "type": "array",
          "default": [],
          "scope": "application",
          "markdownDescription": "**MCP** servers (stdio) available to the agent. E.g.: `[{ \"name\": \"fs\", \"command\": \"npx\", \"args\": [\"-y\",\"@modelcontextprotocol/server-filesystem\",\".\"] }]`. (User settings only — repositories cannot change it.)",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string"
              },
              "command": {
                "type": "string"
              },
              "args": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "required": [
              "name",
              "command"
            ]
          },
          "order": 17
        }
      }
    },
    "walkthroughs": [
      {
        "id": "mangaba.getStarted",
        "title": "Get started with Mangaba AI",
        "description": "Set up and use the sovereign Brazilian AI Mangaba inside VS Code.",
        "steps": [
          {
            "id": "open",
            "title": "Open the chat — it already works",
            "description": "Click the **Mangaba AI** icon in the Activity Bar (or `Ctrl/Cmd+Alt+M`) and start chatting. The extension **comes already connected** to the Mangaba server — no setup needed.\n\n[Open chat](command:mangaba.openChat)",
            "media": {
              "image": "media/icon-128.png",
              "altText": "Mangaba AI"
            }
          },
          {
            "id": "model",
            "title": "Choose the model",
            "description": "At the top of the panel, the selector lists the Mangaba Router models (`mangaba-titan`, `mangaba-coder`, `mangaba-bolt`, `mangaba-vl` and others). The **Mangaba icon in the status bar** shows whether the server is online.",
            "media": {
              "image": "media/icon-128.png",
              "altText": "Model selector"
            }
          },
          {
            "id": "attach",
            "title": "Attach files and images",
            "description": "**Drag and drop** files into the chat, **paste** (`Ctrl/Cmd+V`) or use the **paperclip** — code, text, **PDF** (text extracted automatically) and **images** (vision). Click the chip to preview.",
            "media": {
              "image": "media/icon-128.png",
              "altText": "Attach files"
            }
          },
          {
            "id": "slash",
            "title": "Quick commands with /",
            "description": "Type **`/`** in the message box: `/explain`, `/tests`, `/doc`, `/refactor`, `/fix`, `/export`, `/clear`. You can also **regenerate**, **edit** (`↑`) and **copy** any message.",
            "media": {
              "image": "media/icon-128.png",
              "altText": "Slash commands"
            }
          },
          {
            "id": "explain",
            "title": "Explain and edit code",
            "description": "Select a snippet in the editor and use **Explain Selection** (`Cmd/Ctrl+Alt+E`) or **Edit Selection (AI)** (`Cmd/Ctrl+Alt+K`). Code blocks have **Apply / Insert / Copy** with a review diff.",
            "media": {
              "image": "media/icon-128.png",
              "altText": "Explain Selection"
            },
            "completionEvents": [
              "onCommand:mangaba.explainSelection"
            ]
          },
          {
            "id": "agent",
            "title": "Autonomous agent and RAG",
            "description": "Run **Autonomous Agent (task)** to plan/edit/verify in a loop (with approval and rollback), and **Index Project** so the chat retrieves snippets of your code automatically.",
            "media": {
              "image": "media/icon-128.png",
              "altText": "Autonomous agent"
            }
          },
          {
            "id": "config",
            "title": "(Optional) Use your own server",
            "description": "For full sovereignty, point `mangaba.baseUrl` to your OpenAI-compatible endpoint — your code never leaves your infrastructure.\n\n[Open settings](command:workbench.action.openSettings?%22mangaba%22)",
            "media": {
              "image": "media/icon-128.png",
              "altText": "Settings"
            }
          }
        ]
      }
    ]
  },
  "scripts": {
    "build": "node esbuild.js",
    "watch": "node esbuild.js --watch",
    "vscode:prepublish": "node esbuild.js --production",
    "test": "tsx --test test/*.test.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "package": "npx --yes @vscode/vsce package"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/vscode": "^1.85.0",
    "esbuild": "^0.24.0",
    "tsx": "^4.19.2",
    "typescript": "^5"
  },
  "dependencies": {
    "@xenova/transformers": "^2.17.2",
    "pdfjs-dist": "^4.10.38"
  }
}
